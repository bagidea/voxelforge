+/// The shade amplitude [`tile_height`] normalises against.
+///
+/// `tile_shade` is written in sRGB steps and its deepest features (a brick joint
+/// at `-22`, a foliage gap at `-26+`, a plank groove at `-16` under its grain) sit
+/// inside ±40, so this maps "the darkest thing the tile paints" to roughly a full
+/// unit of depth.
+const SHADE_SPAN: f32 = 40.0;
+
+/// Texels of horizontal run per unit of height — the slope the relief maths is
+/// calibrated in. At `relief: 1.0` a full-unit step across one texel comes out
+/// around 68°, which is a rounded cobble edge, not a cliff.
+const RELIEF_GAIN: f32 = 2.5;
+
+/// Tile-local surface height in `-1.0..=1.0`, wrapped at the tile edge.
+///
+/// The height field IS the albedo pattern. `tile_shade` already paints a plank
+/// groove, a mortar joint and the gap between two cobbles darker — because that
+/// is what those things are — so deriving relief from it keeps normal and albedo
+/// in register by construction. A normal map that disagrees with its own albedo
+/// is precisely what reads as plastic.
+///
+/// Coordinates are wrapped (not clamped) because every `tile_shade` pattern is
+/// seamless and the tile is sampled in `Repeat`: a clamped edge would bake a
+/// one-texel ridge into every block boundary — the same class of bug as the old
+/// painted border, just in the normal instead of the colour.
+#[inline]
+fn tile_height(id: BlockId, x: i32, y: i32) -> f32 {
+    let p = TILE_PX as i32;
+    let shade = tile_shade(id, x.rem_euclid(p) as usize, y.rem_euclid(p) as usize);
+    (shade as f32 / SHADE_SPAN).clamp(-1.0, 1.0)
+}
+
+/// Build the tangent-space normal map for one block type, from its own tile
+/// pattern ([`tile_height`]).
+///
+/// This is the half of "material response" that a per-block `perceptual_roughness`
+/// cannot buy: without it every texel of a face shares one shading normal, so the
+/// sun answers a whole cobble wall with a single flat value and the painted stones
+/// stay a picture of stones. Requires [`greedy_mesh_chunk_split`]'s tangents.
+///
+/// `Rgba8Unorm`, NOT `Rgba8UnormSrgb`: a normal map is a vector, and running it
+/// through the sRGB transfer curve bends every normal toward the surface — the
+/// classic silently-wrong normal map.
+pub fn build_block_normal_map(id: BlockId) -> Image {
+    let strength = block_surface(id).relief * relief_knob(RELIEF_KNOB) * RELIEF_GAIN;
+    let mut data = vec![0u8; TILE_PX * TILE_PX * 4];
+    for ly in 0..TILE_PX as i32 {
+        for lx in 0..TILE_PX as i32 {
+            // Central difference over the wrapped height field.
+            let dhdu = 0.5 * (tile_height(id, lx + 1, ly) - tile_height(id, lx - 1, ly));
+            let dhdv = 0.5 * (tile_height(id, lx, ly + 1) - tile_height(id, lx, ly - 1));
+            // Surface normal of the height field: a hollow tilts its normals back
+            // toward its own centre, which is what makes it shade like a hollow.
+            let n = Vec3::new(-dhdu * strength, -dhdv * strength, 1.0).normalize();
+            let px = (ly as usize * TILE_PX + lx as usize) * 4;
+            for (c, v) in [n.x, n.y, n.z].into_iter().enumerate() {
+                data[px + c] = ((v * 0.5 + 0.5) * 255.0).round().clamp(0.0, 255.0) as u8;
+            }
+            data[px + 3] = 255;
+        }
+    }
+    image_from_rgba_linear(TILE_PX, TILE_PX, data, voxel_sampler(true))
+}
+
+/// Build the metallic-roughness map for one block type: recesses rough, high
+/// points polished, plus a coarse patchiness so a long wall is not one uniform
+/// finish.
+///
+/// Channel layout is Bevy's (glTF's): **G = roughness, B = metallic**, each a
+/// MULTIPLIER on the material's factor. Nothing in this palette is metal, so B is
+/// pinned to neutral 255 and the material's `metallic: 0.0` does the deciding;
+/// G runs `roughness(x,y) / roughness_ceiling`, which is why
+/// [`block_material`] raises the factor to that ceiling.
+///
+/// Linear, like the normal map — these are numbers, not colours.
+pub fn build_block_metallic_roughness(id: BlockId) -> Image {
+    let s = block_surface(id);
+    let ceiling = roughness_ceiling(&s);
+    let spread = s.roughness_var * relief_knob(ROUGH_VAR_KNOB);
+    let mut data = vec![0u8; TILE_PX * TILE_PX * 4];
+    for ly in 0..TILE_PX {
+        for lx in 0..TILE_PX {
+            let h = tile_height(id, lx as i32, ly as i32);
+            // Coarse (4×4-texel) patches so the variation survives being seen
+            // from across the village, where the per-texel term is sub-pixel.
+            let patch = dither(lx as u32 / 4, ly as u32 / 4, 77, 100) as f32 / 100.0;
+            let r = s.perceptual_roughness + spread * (-h * 0.7 + patch * 0.3);
+            let px = (ly * TILE_PX + lx) * 4;
+            data[px] = 255; // R: unused by StandardMaterial (occlusion is its own map).
+            data[px + 1] = ((r / ceiling).clamp(0.0, 1.0) * 255.0).round() as u8;
+            data[px + 2] = 255; // B: neutral metallic multiplier.
+            data[px + 3] = 255;
+        }
+    }
+    image_from_rgba_linear(TILE_PX, TILE_PX, data, voxel_sampler(true))
+}

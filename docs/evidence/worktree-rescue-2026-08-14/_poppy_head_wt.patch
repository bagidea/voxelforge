+    // ---- material response: normal + roughness maps ----
+
+    /// Normals and roughness are numbers, not colours. An sRGB view of them bends
+    /// every value it holds — the classic silently-wrong normal map, and the one
+    /// failure mode here that looks *almost* right on screen.
+    #[test]
+    fn derived_maps_are_linear_and_the_albedo_is_srgb() {
+        for id in [BlockId::WOOD, BlockId::COBBLESTONE, BlockId::GRASS] {
+            assert_eq!(
+                build_block_normal_map(id).texture_descriptor.format,
+                TextureFormat::Rgba8Unorm,
+                "{} normal map must be linear",
+                id.name()
+            );
+            assert_eq!(
+                build_block_metallic_roughness(id).texture_descriptor.format,
+                TextureFormat::Rgba8Unorm,
+                "{} roughness map must be linear",
+                id.name()
+            );
+            assert_eq!(
+                build_block_texture(id).texture_descriptor.format,
+                TextureFormat::Rgba8UnormSrgb,
+                "{} albedo is a colour and must stay sRGB",
+                id.name()
+            );
+        }
+    }
+
+    /// Every derived map has to repeat with the albedo it belongs to — the split
+    /// path's UVs run 0..w blocks, so a clamped map would smear one texel of
+    /// relief across an entire merged wall.
+    #[test]
+    fn derived_maps_repeat_like_their_albedo() {
+        for img in [
+            build_block_normal_map(BlockId::BRICK),
+            build_block_metallic_roughness(BlockId::BRICK),
+        ] {
+            let ImageSampler::Descriptor(d) = &img.sampler else {
+                panic!("derived maps must pin an explicit sampler descriptor")
+            };
+            assert_eq!(d.address_mode_u, ImageAddressMode::Repeat);
+            assert_eq!(d.address_mode_v, ImageAddressMode::Repeat);
+            assert_eq!(d.mag_filter, ImageFilterMode::Nearest);
+        }
+    }
+
+    /// The height field is sampled wrapped, not clamped. Clamping would bake a
+    /// one-texel ridge into every block boundary — the old painted-border bug all
+    /// over again, just in the normal instead of the colour.
+    #[test]
+    fn tile_height_wraps_at_the_tile_edge() {
+        for id in [BlockId::WOOD, BlockId::BRICK, BlockId::COBBLESTONE] {
+            for k in 0..TILE_PX as i32 {
+                assert_eq!(tile_height(id, -1, k), tile_height(id, TILE_PX as i32 - 1, k));
+                assert_eq!(tile_height(id, k, TILE_PX as i32), tile_height(id, k, 0));
+            }
+        }
+    }
+
+    /// The whole point: the map must actually tilt. A map that decodes to a flat
+    /// +Z everywhere is a texture fetch that changes nothing — which is exactly
+    /// what "the materials still read flat" looked like.
+    #[test]
+    fn normal_maps_tilt_where_the_material_has_relief() {
+        // Wood: the plank groove sits on every 4th row, so it must tilt in v.
+        let wood = build_block_normal_map(BlockId::WOOD);
+        let tilt = (0..TILE_PX)
+            .flat_map(|y| (0..TILE_PX).map(move |x| (x, y)))
+            .map(|(x, y)| {
+                let n = decoded_normal(&wood, x, y);
+                n.truncate().length()
+            })
+            .fold(0.0f32, f32::max);
+        assert!(
+            tilt > 0.25,
+            "wood grooves barely move the normal (max xy tilt {tilt}) — the map is doing nothing"
+        );
+
+        // Every decoded normal must still be a unit vector pointing OUT of the
+        // surface; a negative z means the encode wrapped and the texel would
+        // light as if it faced backwards.
+        for id in BlockId::ALL_PLACEABLE.iter().copied().chain([LAMP]) {
+            if block_surface(id).relief <= 0.0 {
+                continue;
+            }
+            let img = build_block_normal_map(id);
+            for y in 0..TILE_PX {
+                for x in 0..TILE_PX {
+                    let n = decoded_normal(&img, x, y);
+                    assert!(n.z > 0.0, "{} texel ({x},{y}) faces backwards", id.name());
+                    assert!(
+                        (n.length() - 1.0).abs() < 0.02,
+                        "{} texel ({x},{y}) decodes to length {}",
+                        id.name(),
+                        n.length()
+                    );
+                }
+            }
+        }
+    }
+
+    /// Relief is a per-material decision, not a global filter: the pane is
+    /// deliberately flat and must get NO normal map, while loose cobbles get the
+    /// strongest one in the palette.
+    #[test]
+    fn relief_is_graded_per_material_and_the_pane_stays_flat() {
+        let mut images = Assets::<Image>::default();
+        let mut materials = Assets::<StandardMaterial>::default();
+        let table = build_block_materials(&mut images, &mut materials);
+
+        let pane = materials.get(&table[BlockId::OBSIDIAN.0 as usize]).unwrap();
+        assert!(
+            pane.normal_map_texture.is_none(),
+            "bumping a polished pane only frosts it"
+        );
+        for id in [BlockId::COBBLESTONE, BlockId::WOOD, BlockId::GRASS] {
+            let m = materials.get(&table[id.0 as usize]).unwrap();
+            assert!(
+                m.normal_map_texture.is_some() && m.metallic_roughness_texture.is_some(),
+                "{} should carry both derived maps",
+                id.name()
+            );
+        }
+        assert!(
+            block_surface(BlockId::COBBLESTONE).relief > block_surface(BlockId::LIMESTONE).relief,
+            "a pile of loose stones has more relief than a plaster wall"
+        );
+    }
+
+    /// Bevy MULTIPLIES `perceptual_roughness` by the map's green channel, so the
+    /// factor has to be the ceiling of the range and the map dips below it. Get
+    /// this backwards and every mapped surface is quietly smoother than the table
+    /// says — with no error anywhere.
+    #[test]
+    fn roughness_map_brackets_the_tables_value_instead_of_only_darkening_it() {
+        let id = BlockId::WOOD;
+        let s = block_surface(id);
+        let m = block_material(
+            id,
+            BlockTextures {
+                metallic_roughness: Some(Handle::default()),
+                ..default()
+            },
+        );
+        assert!(
+            m.perceptual_roughness > s.perceptual_roughness,
+            "factor must be raised to the ceiling when a roughness map is present"
+        );
+
+        let img = build_block_metallic_roughness(id);
+        let d = img.data.as_ref().unwrap();
+        let g: Vec<f32> = (0..TILE_PX * TILE_PX)
+            .map(|i| d[i * 4 + 1] as f32 / 255.0)
+            .collect();
+        let lo = g.iter().cloned().fold(f32::INFINITY, f32::min) * m.perceptual_roughness;
+        let hi = g.iter().cloned().fold(0.0f32, f32::max) * m.perceptual_roughness;
+        assert!(
+            lo < s.perceptual_roughness && hi > s.perceptual_roughness,
+            "effective roughness {lo}..{hi} must straddle the table's {}",
+            s.perceptual_roughness
+        );
+        // Nothing in this palette is metal, so B stays a neutral multiplier.
+        assert!((0..TILE_PX * TILE_PX).all(|i| d[i * 4 + 2] == 255));
+
+        // No map => the factor is the table value verbatim.
+        assert_eq!(
+            block_material(id, BlockTextures::default()).perceptual_roughness,
+            s.perceptual_roughness
+        );
+    }
+
+    /// Without a tangent frame Bevy's PBR shader drops the normal map on the
+    /// floor and renders exactly the flat version — no warning, no error. This is
+    /// the test that would have caught shipping the maps and seeing no change.
+    #[test]
+    fn split_meshes_carry_an_exact_tangent_frame() {
+        let parts = greedy_mesh_chunk_split(&pad(true));
+        assert!(!parts.is_empty());
+        for (_, mesh, _) in &parts {
+            let tans = tangents(mesh).expect("split meshes must carry TANGENT");
+            let norms = normals(mesh);
+            assert_eq!(tans.len(), norms.len());
+            for (t, n) in tans.iter().zip(&norms) {
+                let tv = Vec3::new(t[0], t[1], t[2]);
+                let nv = Vec3::from_array(*n);
+                assert!((tv.length() - 1.0).abs() < 1e-5, "tangent {tv:?} not unit");
+                assert!(tv.dot(nv).abs() < 1e-5, "tangent {tv:?} not ⟂ normal {nv:?}");
+                assert!(t[3] == 1.0 || t[3] == -1.0, "handedness {} is not ±1", t[3]);
+                // The reconstructed bitangent must be the +v axis of the quad's
+                // own UVs — that is what puts the map's green channel where the
+                // mesher said v goes.
+                let bitangent = nv.cross(tv) * t[3];
+                assert!(
+                    (bitangent.length() - 1.0).abs() < 1e-5,
+                    "bitangent {bitangent:?} not unit"
+                );
+            }
+        }
+
+        // The atlas/LOD path stretches one tile over a whole merged quad and wears
+        // no normal map, so it must not pay for the attribute either.
+        let (atlas_mesh, _) = greedy_mesh_chunk(&pad(true));
+        assert!(
+            tangents(&atlas_mesh).is_none(),
+            "the atlas path has no normal map to feed"
+        );
+    }
+
+    /// The A/B lever has to strip BOTH maps, or the "before" frame is not a

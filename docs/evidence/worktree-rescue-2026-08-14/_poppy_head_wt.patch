+/// The top of a surface's roughness range — the factor the roughness map divides
+/// against. Bevy clamps `perceptual_roughness` at 1.0, so the spread is only ever
+/// allowed to reach down from there.
+#[inline]
+fn roughness_ceiling(s: &BlockSurface) -> f32 {
+    (s.perceptual_roughness + relief_knob(ROUGH_VAR_KNOB) * s.roughness_var).min(1.0)
+}
+
+const RELIEF_KNOB: &str = "VOXELFORGE_MAT_RELIEF";
+const ROUGH_VAR_KNOB: &str = "VOXELFORGE_MAT_ROUGH_VAR";
+
+/// Global multiplier on one of the two amplitude knobs, read once from the
+/// environment. Default `1.0` — the shipped grade in [`block_surface`].
+///
+/// Relief amplitude is the one number in this pass that can only be judged from a
+/// rendered frame, and this binary costs a fat-LTO link to rebuild. So the knob is
+/// a runtime scale, not a recompile: `VOXELFORGE_MAT_RELIEF=0.6` sweeps the whole
+/// palette down proportionally, keeping the per-material *grade* intact.
+/// `=0` is the same as having no normal map at all.
+///
+/// A negative or non-numeric value falls back to 1.0 rather than inverting every
+/// surface in the game on a typo.
+fn relief_knob(key: &'static str) -> f32 {
+    static KNOBS: std::sync::OnceLock<Vec<(&'static str, f32)>> = std::sync::OnceLock::new();
+    let knobs = KNOBS.get_or_init(|| {
+        [RELIEF_KNOB, ROUGH_VAR_KNOB]
+            .into_iter()
+            .map(|k| {
+                let v = std::env::var(k)
+                    .ok()
+                    .and_then(|v| v.trim().parse::<f32>().ok())
+                    .filter(|v| v.is_finite() && *v >= 0.0)
+                    .unwrap_or(1.0);
+                if v != 1.0 {
+                    println!("MATERIAL {k}={v}");
+                }
+                (k, v)
+            })
+            .collect()
+    });
+    knobs
+        .iter()
+        .find(|(k, _)| *k == key)
+        .map(|(_, v)| *v)
+        .unwrap_or(1.0)
+}

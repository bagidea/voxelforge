 }
 
+/// Is the per-frame boom trace switched on? Read once — this sits in the camera's
+/// hot path.
+fn boom_trace_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VOXELFORGE_BOOM_TRACE").is_ok())
+}
+
+/// `VOXELFORGE_BOOM_WALK=<secs>` holds W for `<secs>` and then quits, so the avatar
+/// really walks along a wall — the boom's step-jitter only appears while the pivot
+/// is moving. The key is pressed into `ButtonInput<KeyCode>` exactly the way the
+/// quest demo does it, so the input goes *through* the real controller, not around
+/// it.
+fn boom_walk_demo(
+    time: Res<Time>,
+    mut keys: ResMut<ButtonInput<KeyCode>>,
+    mut exit: MessageWriter<AppExit>,
+) {
+    let Some(secs) = std::env::var("VOXELFORGE_BOOM_WALK")
+        .ok()
+        .and_then(|v| v.parse::<f32>().ok())
+    else {
+        return;
+    };
+    let t = time.elapsed_secs();
+    if t < 0.5 {
+        return; // let the scene finish loading before the first step
+    }
+    if t > 0.5 + secs {
+        exit.write(AppExit::Success);
+        return;
+    }
+    keys.press(KeyCode::KeyW);
+}

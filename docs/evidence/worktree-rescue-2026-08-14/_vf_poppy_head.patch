+        prev + (raw - prev) * (1.0 - (-BOOM_RELEASE_K * dt).exp())
     };
     orbit.dist = dist;
+    // `VOXELFORGE_BOOM_TRACE=1` prints the boom every frame — `raw` straight out of
+    // `camera_boom` (quantized to its 0.1 march) next to the length actually used.

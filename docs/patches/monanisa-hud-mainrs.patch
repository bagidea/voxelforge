+/// F3 toggles the debug overlay on/off. A bare `KeyCode::F3` check, same
+/// pattern as the existing F5/F7/F9 shortcuts — this isn't a rebindable
+/// `EditorAction`, it's a dev/QA overlay.
+fn toggle_debug_overlay(keys: Res<ButtonInput<KeyCode>>, mut overlay: ResMut<DebugOverlay>) {
+    if keys.just_pressed(KeyCode::F3) {
+        overlay.0 = !overlay.0;
+    }
+}

+def is_sky(r, g, b):
+    """The clear-colour sky, read off the OFF frame.
+
+    Measured, not guessed: in the zero-fog reference frame every such pixel lands
+    in R 122-128 / G 160-167 / B 222-228, and 21321 of the 21962 the band
+    contains have EXACTLY zero delta under the shipped haze. The rule below is
+    that footprint with room around it; no block in the palette (terracotta,
+    stone, grass, wood) is both this blue and this bright.
+    """
+    return b >= 200 and b - r >= 60 and b > g > r
+

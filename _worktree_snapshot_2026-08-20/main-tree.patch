+Shoot "novfog"      @{ VOXELFORGE_LOOK_VFOG = "off" }
+# DistanceFog pushed past the whole scene = the no-haze arm ("off" is not a
+# value VOXELFORGE_LOOK_HAZE parses; it would silently fall back to the default).
